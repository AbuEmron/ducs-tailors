<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions are deliberately minimal.

      There is no location permission: the platform works from a city the member types in,
      because a service directory does not need to know where anybody is standing. There is
      no contacts permission, no camera permission, and no advertising identifier. Each of
      those would be an ordinary thing for a community app to ask for, and each would be a
      new way for this platform to learn something about people it has no business knowing.

      INTERNET is required for the production backend. POST_NOTIFICATIONS is requested at
      runtime, and only for commitments a member made and conversations they are part of.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FiSabilillahApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FiSabilillah">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FiSabilillah">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deep links, matching the URIs the notification use cases emit
              (fisabilillah://conversation/{id} and so on).
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fisabilillah" />
            </intent-filter>
        </activity>
    </application>

</manifest>
