<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      A separate drawable rather than reusing the foreground. The themed-icon
      layer is composited in a single tint colour, so a foreground that carries
      two colours loses the crescent and the arcade entirely and comes out as
      a solid blob. This one is drawn to work in one colour.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
