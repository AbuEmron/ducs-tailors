# Fi Sabilillah — environment variables
#
# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way.
#
# IMPORTANT: nothing in this repository reads these yet. The application is
# currently backed by the in-memory development fixture in `core:data`, and
# authentication is a stand-in that selects a seeded account. This file
# documents the variables the Supabase-backed production path will need, so
# that the names are settled before anybody writes the wiring.
#
# See docs/deployment.md before creating any real environment.

# =============================================================================
# Supabase — the production data layer
# =============================================================================

# The project URL. Safe to ship in a client.
SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable (anon) key. Safe to ship in a client: every request made with
# it is subject to row-level security, and RLS is enabled on all 58 tables.
# See backend/docs/rls-model.md.
SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# ***  SERVICE ROLE KEY — READ THIS BEFORE YOU PASTE ANYTHING BELOW  ***
# -----------------------------------------------------------------------------
#
# This key BYPASSES ROW-LEVEL SECURITY ENTIRELY.
#
# Every guarantee described in docs/safeguards.md, docs/privacy-model.md and
# docs/wali-workflow.md is enforced by RLS. This key turns all of it off. A
# holder of this key can read every wali's phone number, every home address on
# every help request, every private message, and every moderation case — and can
# write to the append-only audit log.
#
#   * NEVER embed it in an Android build. An APK is not a secret.
#   * NEVER put it in a client-side configuration file of any kind.
#   * NEVER commit it, paste it into an issue, or include it in a log.
#   * Server-side jobs and CI only. Held in a managed secret store, rotatable,
#     with a rehearsed rotation procedure.
#
# Its compromise is treated as its own attack path — backend/docs/threat-model.md
# AP-13.
#
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for applying migrations. Also privileged; the same
# rules apply. Used by `supabase db push` and by the seed step.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Storage bucket names. Object PATHS are stored in the database as plain text;
# public URLs are never stored. Bucket policies are configured separately in the
# Supabase dashboard and MUST mirror backend/docs/rls-model.md — a public bucket
# undoes the whole privacy model regardless of what the row policies say.
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_EVIDENCE=evidence
SUPABASE_BUCKET_ATTACHMENTS=attachments

# =============================================================================
# Local development database
# =============================================================================
# Used by backend/supabase/run_local_tests.sh against a plain PostgreSQL 16
# cluster. Defaults are shown; override only if your setup differs.

PGDATABASE_TEST=fisabilillah_test
PG_SUPERUSER=postgres
# PG_BIN=/usr/lib/postgresql/16/bin
# KEEP_DB=1

# =============================================================================
# Identity verification provider  —  NOT YET WIRED UP
# =============================================================================
# VerificationLevel.IDENTITY_VERIFIED currently means NOTHING HAS BEEN CHECKED.
# No provider is integrated. A badge that overstates what was checked is worse
# than no badge, so this must be real before the badge is shown to anybody.
#
# The provider must supply: government identity document verification, and an
# age attribute (the platform is adults-only — see docs/child-safety.md).
#
# Background checks (VerificationLevel.BACKGROUND_CHECKED) are enforced by the
# code for categories where ServiceCategory.requiresBackgroundCheckByDefault is
# true, but no check is actually performed by anybody. Same status: not wired up.

IDENTITY_VERIFICATION_PROVIDER=
IDENTITY_VERIFICATION_API_KEY=
IDENTITY_VERIFICATION_WEBHOOK_SECRET=

BACKGROUND_CHECK_PROVIDER=
BACKGROUND_CHECK_API_KEY=
BACKGROUND_CHECK_WEBHOOK_SECRET=

# =============================================================================
# Malware scanning hook  —  NOT YET WIRED UP
# =============================================================================
# Uploads (avatars, report evidence, message attachments) are not scanned. This
# is named as a gap in docs/privacy-model.md and must exist before any
# environment accepts uploads from real members.

MALWARE_SCAN_ENDPOINT=
MALWARE_SCAN_API_KEY=

# =============================================================================
# Payment provider  —  NOT YET WIRED UP, AND GATED
# =============================================================================
# Payments are disabled behind DonationFeatureFlags.paymentsEnabled = false, a
# compile-time constant. The database enforces the same thing independently with
# `check (payments_enabled = false)` on campaigns. No money can move.
#
# Filling these in does NOT enable payments. Enabling payments requires the
# entire checklist in docs/payment-compliance.md to be complete: legal entity,
# charitable-solicitation registration per jurisdiction, tax handling, a licensed
# provider, KYC/KYB on receiving organisations, sanctions screening, refund and
# dispute policy, restricted-fund accounting, and PCI scope.
#
# Card details must never touch this platform's servers or client. Hosted fields,
# a redirect, or the provider's own SDK only.

PAYMENT_PROVIDER=
PAYMENT_PROVIDER_PUBLISHABLE_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# =============================================================================
# Application
# =============================================================================

# The version string recorded against every consent record, so that what a
# member agreed to is unambiguous. Bump it whenever the terms, privacy policy,
# community guidelines, or the automated-safety-processing notice change.
CONSENT_DOCUMENT_VERSION=2026-03-01

# Deep-link scheme emitted by the notification use cases. Changing this breaks
# every notification already delivered.
APP_DEEP_LINK_SCHEME=fisabilillah

# development | staging | production
APP_ENVIRONMENT=development
